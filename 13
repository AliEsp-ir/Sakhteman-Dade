# --- Node دوطرفه ---
class DNode:
    def __init__(self, value):
        self.value = value
        self.next = None
        self.prev = None


# --- Doubly Linked List ---
class DoublyLinkedList:
    def __init__(self):
        self.head = None

    # --- حذف گره بعد از مقدار مشخص ---
    def delete_after(self, target):
        if not self.head:
            print("List is empty")
            return

        current = self.head
        while current:
            if current.value == target:
                if current.next:
                    node_to_delete = current.next
                    current.next = node_to_delete.next
                    if node_to_delete.next:
                        node_to_delete.next.prev = current
                    del node_to_delete
                    return
                else:
                    print(f"No node exists after {target}")
                    return
            current = current.next

        print(f"Value {target} not found")

    # --- حذف گره با مقدار مشخص ---
    def delete_node(self, target):
        if not self.head:
            print("List is empty")
            return

        current = self.head

        while current:
            if current.value == target:
                # اگر گره اول باشد
                if current.prev is None:
                    self.head = current.next
                    if self.head:
                        self.head.prev = None
                    del current
                    return

                # اگر گره آخر باشد
                if current.next is None:
                    current.prev.next = None
                    del current
                    return

                # گره میانی
                current.prev.next = current.next
                current.next.prev = current.prev
                del current
                return

            current = current.next

        print(f"Value {target} not found")

    # --- نمایش لیست به جلو ---
    def display_forward(self):
        current = self.head
        while current:
            print(current.value, end=" <-> ")
            current = current.next
        print("None")
