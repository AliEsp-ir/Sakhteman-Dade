def custom_complexity(n):
    # ثابت‌ها (2 دستور)
    total = 0
    flag = True

    # بخش مربعی: حدود (n) * (n/3)  ≈  n^2 / 3
    # با 4 دستور در هر تکرار → 4/3 n^2
    for outer in range(n):
        for inner in range(0, n, 3):
            total += 1
            total -= 1
            total *= 1
            total //= 1

        # بخش خطی: 6 دستور برای هر i → 6n
        total += outer
        total -= outer
        total *= 1
        total //= 1
        flag = not flag
        total += 0

    return total
