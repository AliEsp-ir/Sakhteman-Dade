# --- Node دوطرفه ---
class DNode:
    def __init__(self, value):
        self.value = value
        self.next = None
        self.prev = None


# --- Doubly Linked List ---
class DoublyLinkedList:
    def __init__(self):
        self.head = None

    # --- درج در ابتدا ---
    def insert_first(self, value):
        new_node = DNode(value)
        if self.head:
            new_node.next = self.head
            self.head.prev = new_node
        self.head = new_node

    # --- درج در انتها ---
    def insert_last(self, value):
        if not self.head:
            self.insert_first(value)
            return
        current = self.head
        while current.next:
            current = current.next
        new_node = DNode(value)
        current.next = new_node
        new_node.prev = current

    # --- درج بعد از مقدار مشخص ---
    def insert_after(self, target, value):
        if not self.head:
            print("List is empty")
            return
        current = self.head
        while current:
            if current.value == target:
                if current.next is None:
                    self.insert_last(value)
                    return
                new_node = DNode(value)
                new_node.next = current.next
                current.next.prev = new_node
                current.next = new_node
                new_node.prev = current
                return
            current = current.next
        print(f"Value {target} not found")

    # --- درج قبل از مقدار مشخص ---
    def insert_before(self, target, value):
        if not self.head:
            print("List is empty")
            return
        current = self.head
        while current:
            if current.value == target:
                if current.prev is None:
                    self.insert_first(value)
                    return
                new_node = DNode(value)
                new_node.next = current
                new_node.prev = current.prev
                current.prev.next = new_node
                current.prev = new_node
                return
            current = current.next
        print(f"Value {target} not found")

    # --- حذف اولین گره ---
    def delete_first(self):
        if not self.head:
            print("List is empty")
            return
        temp = self.head
        self.head = self.head.next
        if self.head:
            self.head.prev = None
        del temp

    # --- حذف آخرین گره ---
    def delete_last(self):
        if not self.head:
            print("List is empty")
            return
        current = self.head
        while current.next:
            current = current.next
        if current.prev is None:
            self.delete_first()
        else:
            current.prev.next = None
            del current

    # --- حذف گره قبل از مقدار مشخص ---
    def delete_before(self, target):
        if not self.head or self.head.value == target:
            print("No node before target")
            return
        current = self.head
        while current:
            if current.value == target:
                node_to_delete = current.prev
                if node_to_delete.prev:
                    node_to_delete.prev.next = current
                    current.prev = node_to_delete.prev
                else:
                    current.prev = None
                    self.head = current
                del node_to_delete
                return
            current = current.next
        print(f"Value {target} not found")

    # --- نمایش لیست ---
    def display_forward(self):
        current = self.head
        while current:
            print(current.value, end=" <-> ")
            current = current.next
        print("None")

    def display_backward(self):
        current = self.head
        if not current:
            print("None")
            return
        while current.next:
            current = current.next
        while current:
            print(current.value, end=" <-> ")
            current = current.prev
        print("None")
