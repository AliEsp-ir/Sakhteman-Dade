# --- Node درخت باینری ---
class TreeNode:
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None


# --- تعداد برگ‌ها ---
def count_leaves(root):
    if root is None:
        return 0
    if root.left is None and root.right is None:
        return 1
    return count_leaves(root.left) + count_leaves(root.right)


# --- تعداد گره‌های درجه 1 ---
def count_degree_one(root):
    if root is None:
        return 0
    count = 0
    if (root.left is None) != (root.right is None):  # فقط یکی از بچه‌ها وجود دارد
        count = 1
    return count + count_degree_one(root.left) + count_degree_one(root.right)


# --- تعداد گره‌های درجه 2 ---
def count_degree_two(root):
    if root is None:
        return 0
    count = 0
    if root.left and root.right:  # هر دو بچه وجود دارد
        count = 1
    return count + count_degree_two(root.left) + count_degree_two(root.right)


# --- مجموع داده‌های درخت ---
def sum_tree(root):
    if root is None:
        return 0
    return root.value + sum_tree(root.left) + sum_tree(root.right)


