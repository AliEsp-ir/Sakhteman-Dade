    while x < n:
        y = 0
        while y < n:
            v1 = x
            v2 = y
            v3 = x + y
            count += 3
            y += 1
        x += 1

    # بخش خطی: (n - 2) بار تکرار
    i = 0
    limit = n - 2
    while i < limit:
        p = 1
        q = 2
        r = 3
        s = 4
        count += 4
        i += 1

    return count
